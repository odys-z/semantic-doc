<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.odys-z</groupId>
  <artifactId>doctree.jserv</artifactId>
  <version>0.1.0</version>
  <name>semantic-doc doc-tree tier</name>
  <description>The doc-tree tier core of semantic-doc, depended on by synodes (docsync) and the demo jserv</description>
  <url>https://github.com/odys-z/semantic-doc</url>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	<maven.compiler.source>17</maven.compiler.source>
	<maven.compiler.target>17</maven.compiler.target>
  </properties>

  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Ody Zhou</name>
      <email>odys.zhou@gmail.com</email>
      <organization>odys-z.github.io</organization>
      <organizationUrl>https://odys-z.github.io</organizationUrl>
    </developer>
  </developers>

  <dependencies>
  	<dependency>
		<groupId>org.junit.jupiter</groupId>
		<artifactId>junit-jupiter-engine</artifactId>
		<version>6.1.0</version>
		<scope>test</scope>
    </dependency>

  	<dependency>
		<!-- The launcher of the same platform version as the engine. Without it, an IDE's runner
			(Eclipse's JUnit 6 runner) supplies its own, possibly older, launcher:
			NoSuchMethodError Launcher.execute(LauncherExecutionRequest). -->
		<groupId>org.junit.platform</groupId>
		<artifactId>junit-platform-launcher</artifactId>
		<version>6.1.0</version>
		<scope>test</scope>
    </dependency>

   	<dependency>
		<!-- No servlet container or jdbc driver here: those are the app's (demo jserv, synode) choices. -->
	    <groupId>io.github.odys-z</groupId>
	    <artifactId>semantic.jserv</artifactId>
	    <version>[1.5.20,)</version>
   	</dependency>

   	<dependency>
	    <!-- 1.5.26: the sibling width configured only by fullpath semantics (ShFullpath.siblinSize());
	         1.5.27: the autopk handler creates oz_autoseq (sqlite only)
	         1.5.31: ShFullpath2, smtc fullpath2 in semantics-doctree.xml -->
	    <groupId>io.github.odys-z</groupId>
	    <artifactId>semantic.DA</artifactId>
	    <version>[1.5.31,)</version>
   	</dependency>

    <dependency>
      <!-- the docx importer's walker (io.oz.sdoc.docx), verified in hello/docx4j.
           docx4j 11.x = Jakarta XML Binding; pulls in docx4j-core and the Glassfish JAXB RI. -->
      <groupId>org.docx4j</groupId>
      <artifactId>docx4j-JAXB-ReferenceImpl</artifactId>
      <version>11.5.4</version>
    </dependency>

   	<dependency>
		<!-- DoctreeTier is a servlet; the container (Jetty in the synodes) provides the api -->
		<groupId>javax.servlet</groupId>
		<artifactId>javax.servlet-api</artifactId>
		<version>3.1.0</version>
		<scope>provided</scope>
   	</dependency>
  </dependencies>

  <scm>
  	<connection>scm:git:git://github.com/odys-z/semantic-doc.git</connection>
  	<developerConnection>scm:git:odys-z@github.com:odys-z/semantic-doc.git</developerConnection>
  	<url>https://github.com/odys-z/semantic-doc</url>
  	<tag>HEAD</tag>
  </scm>

  <build>
    <plugins>
    	<plugin>
    		<artifactId>maven-compiler-plugin</artifactId>
    		<version>3.7.0</version>
    		<configuration>
    		<source>17</source>
    		<target>17</target>
    		</configuration>
    	</plugin>

		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-surefire-plugin</artifactId>
			<version>3.5.2</version>
		</plugin>
    </plugins>
  </build>
</project>
