<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.odys-z</groupId>
  <artifactId>doctree.jserv</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>semantic-doc doc-tree tier</name>
  <description>The doc-tree tier core of semantic-doc, depended on by synodes (docsync) and the demo jserv</description>
  <url>https://github.com/odys-z/semantic-doc</url>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	<maven.compiler.source>17</maven.compiler.source>
	<maven.compiler.target>17</maven.compiler.target>
  </properties>

  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Ody Zhou</name>
      <email>odys.zhou@gmail.com</email>
      <organization>odys-z.github.io</organization>
      <organizationUrl>https://odys-z.github.io</organizationUrl>
    </developer>
  </developers>

  <dependencies>
  	<dependency>
		<groupId>org.junit.jupiter</groupId>
		<artifactId>junit-jupiter-engine</artifactId>
		<version>6.1.0</version>
		<scope>test</scope>
    </dependency>

   	<dependency>
		<!-- No servlet container or jdbc driver here: those are the app's (demo jserv, synode) choices. -->
	    <groupId>io.github.odys-z</groupId>
	    <artifactId>semantic.jserv</artifactId>
	    <version>[1.5.17,)</version>
   	</dependency>
  </dependencies>

  <scm>
  	<connection>scm:git:git://github.com/odys-z/semantic-doc.git</connection>
  	<developerConnection>scm:git:odys-z@github.com:odys-z/semantic-doc.git</developerConnection>
  	<url>https://github.com/odys-z/semantic-doc</url>
  	<tag>HEAD</tag>
  </scm>

  <build>
    <plugins>
    	<plugin>
    		<artifactId>maven-compiler-plugin</artifactId>
    		<version>3.7.0</version>
    		<configuration>
    		<source>17</source>
    		<target>17</target>
    		</configuration>
    	</plugin>

		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-surefire-plugin</artifactId>
			<version>3.5.2</version>
		</plugin>
    </plugins>
  </build>
</project>
